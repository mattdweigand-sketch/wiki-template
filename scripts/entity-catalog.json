{
  "schema_version": 2,
  "description": "Governed entity-folder and authoring-semantics catalog for the live wiki.",
  "types": [
    {
      "folder": "analyses",
      "type": "analysis",
      "purpose": "A synthesized answer, comparison, brief, or other durable output.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "competitors",
      "type": "competitor",
      "purpose": "A competing vendor, alternative, or substitute and its positioning.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "concepts",
      "type": "concept",
      "purpose": "An idea, term, framework, or mental model used in the configured domain.",
      "review_date": "optional",
      "authority_freshness": "stable-meaning",
      "verification": "when-authority-requires"
    },
    {
      "folder": "customers",
      "type": "customer",
      "purpose": "A named customer or segment, its use cases, relationship, and risks.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "decisions",
      "type": "decision",
      "purpose": "A historical choice, its rationale, alternatives, and outcome-review checkpoint.",
      "review_date": "expected",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "features",
      "type": "feature",
      "purpose": "A specific customer-facing capability and the jobs it supports.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "goals",
      "type": "goal",
      "purpose": "A desired outcome with status, blockers, and a dated outcome review.",
      "review_date": "expected",
      "authority_freshness": "current-state",
      "verification": "before-consequential-action"
    },
    {
      "folder": "health",
      "type": "health",
      "purpose": "Health protocols, experiments, practices, and current context; not medical advice.",
      "review_date": "optional",
      "authority_freshness": "current-state",
      "verification": "before-consequential-action"
    },
    {
      "folder": "initiatives",
      "type": "initiative",
      "purpose": "A strategic program or bet that may coordinate several projects.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "investments",
      "type": "investment",
      "purpose": "An investment thesis, position, current view, risks, and open questions; not financial advice.",
      "review_date": "optional",
      "authority_freshness": "current-state",
      "verification": "before-consequential-action"
    },
    {
      "folder": "learnings",
      "type": "learning",
      "purpose": "A durable lesson tied to evidence or lived experience.",
      "review_date": "optional",
      "authority_freshness": "stable-meaning",
      "verification": "when-authority-requires"
    },
    {
      "folder": "metrics",
      "type": "metric",
      "purpose": "A measurement definition, formula, owner, and observed values.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "partners",
      "type": "partner",
      "purpose": "A vendor, integration partner, channel partner, or collaborator.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "people",
      "type": "person",
      "purpose": "An individual, stakeholder, or role and its responsibilities.",
      "review_date": "optional",
      "authority_freshness": "stable-meaning",
      "verification": "when-authority-requires"
    },
    {
      "folder": "personas",
      "type": "persona",
      "purpose": "A user or buyer archetype with goals, pain points, and authority.",
      "review_date": "optional",
      "authority_freshness": "stable-meaning",
      "verification": "when-authority-requires"
    },
    {
      "folder": "policies",
      "type": "policy",
      "purpose": "A currently binding rule, its scope, authority, exceptions, and review expectations.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "processes",
      "type": "process",
      "purpose": "An organizational procedure with triggers, inputs, steps, outputs, owners, and exceptions.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "products",
      "type": "product",
      "purpose": "A customer-facing offering, its positioning, users, and core jobs.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "projects",
      "type": "project",
      "purpose": "Bounded work with a concrete output or completion condition.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "properties",
      "type": "property",
      "purpose": "An owner manual for a residence or operated property: systems, maintenance, vendors, records, and status.",
      "review_date": "optional",
      "authority_freshness": "current-state",
      "verification": "before-consequential-action"
    },
    {
      "folder": "skills",
      "type": "skill",
      "purpose": "A demonstrated capability and the evidence behind proficiency.",
      "review_date": "optional",
      "authority_freshness": "stable-meaning",
      "verification": "when-authority-requires"
    },
    {
      "folder": "sources",
      "type": "source",
      "purpose": "A summary of one raw artifact and what that evidence supports.",
      "review_date": "optional",
      "authority_freshness": "immutable-source",
      "verification": "when-authority-requires"
    },
    {
      "folder": "systems",
      "type": "system",
      "purpose": "A technical or operational dependency with ownership, interfaces, and failure modes.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    },
    {
      "folder": "teams",
      "type": "team",
      "purpose": "An organizational group with responsibilities and interfaces.",
      "review_date": "optional",
      "authority_freshness": "contextual",
      "verification": "when-authority-requires"
    }
  ]
}
