#!/bin/sh
# Block commits while multi-file recovery authority is nonclean.
#
# Install (once per clone): git config core.hooksPath scripts/hooks
if ! python3 scripts/wiki_transactions.py status --quiet; then
  echo "pre-commit: refusing to commit while .wiki-transactions/ is nonclean." >&2
  echo "Run 'python3 scripts/wiki_transactions.py status' and recover or diagnose the recorded state." >&2
  exit 1
fi
if ! python3 scripts/wiki_provenance.py live; then
  echo "pre-commit: local raw bytes do not match the tracked provenance manifest." >&2
  exit 1
fi
if ! python3 scripts/wiki_provenance.py staged; then
  echo "pre-commit: staged provenance is invalid or a raw source artifact is tracked." >&2
  exit 1
fi
exit 0
