# macOS
.DS_Store
.env
*.swp
*.swo

# Python evaluation caches are local runtime artifacts.
__pycache__/
*.py[cod]

# Export bundles and scratch artifacts are not wiki content.
*.zip
/deliverables/
/tmp/

# Local Claude Code settings
.claude/settings.local.json
.claude/worktrees/

# Stable approval-ledger lock. The inode persists while the ledger is replaced.
scripts/.capture-runs.lock

# Local receipt for an optional verified remote export. It contains no target,
# but remains per-checkout state and must never claim a fresh clone was backed up.
scripts/backup-receipt.json

# Recoverable multi-file transaction authority. Never delete it to clear a gate.
/.wiki-transactions/
